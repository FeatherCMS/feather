#!/usr/bin/env bash
set -Eeuo pipefail

readonly ENV_FILE="/etc/feather/feather.env"
readonly BACKUP_BUCKET="feather-backups"
readonly AWS_REGION="eu-central-1"
readonly LOCK_FILE="/run/lock/feather-postgresql-backup.lock"
readonly FAILED_BACKUP_DIR="/var/backups/feather/failed"

umask 077

if [[ ! -r "$ENV_FILE" ]]; then
    echo "Cannot read application environment: $ENV_FILE" >&2
    exit 1
fi

set -a
# This deployment's EnvironmentFile uses shell-compatible KEY=value entries.
# shellcheck disable=SC1091
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

: "${POSTGRES_DATABASE:?POSTGRES_DATABASE is not configured}"
: "${POSTGRES_USER:?POSTGRES_USER is not configured}"
: "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is not configured}"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "A PostgreSQL backup is already running; skipping this invocation."
    exit 0
fi

backup_date="$(date -u +%Y/%m/%d)"
backup_key="live/${backup_date}/backup.sql"
backup_file="$(mktemp /var/tmp/feather-postgresql-backup.XXXXXX.sql)"
preserve_backup=0
cleanup() {
    if (( preserve_backup )); then
        local retained_file
        retained_file="${FAILED_BACKUP_DIR}/postgresql-$(date -u +%Y%m%dT%H%M%SZ)-$$.sql"
        if install -d -o root -g root -m 0700 "$FAILED_BACKUP_DIR" \
            && mv "$backup_file" "$retained_file"; then
            chmod 0600 "$retained_file"
            printf 'S3 upload failed; retained the completed SQL dump at %s\n' \
                "$retained_file" >&2
        else
            printf 'S3 upload failed; completed SQL dump remains at %s\n' \
                "$backup_file" >&2
        fi
    else
        rm -f "$backup_file"
    fi
}
trap cleanup EXIT

export PGPASSWORD="$POSTGRES_PASSWORD"
pg_dump \
    --host="${POSTGRES_HOST:-127.0.0.1}" \
    --port="${POSTGRES_PORT:-5432}" \
    --username="$POSTGRES_USER" \
    --dbname="$POSTGRES_DATABASE" \
    --format=plain \
    --no-owner \
    --no-privileges \
    --file="$backup_file"
unset PGPASSWORD

if [[ ! -s "$backup_file" ]]; then
    echo "PostgreSQL produced an empty backup; refusing to upload it." >&2
    exit 1
fi

if ! aws --region "$AWS_REGION" s3 cp \
    "$backup_file" "s3://${BACKUP_BUCKET}/${backup_key}" \
    --only-show-errors; then
    preserve_backup=1
    exit 1
fi

printf 'Uploaded PostgreSQL backup to s3://%s/%s (%s bytes)\n' \
    "$BACKUP_BUCKET" "$backup_key" "$(stat -c '%s' "$backup_file")"
