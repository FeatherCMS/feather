#!/usr/bin/env bash
set -Eeuo pipefail

readonly INSTALL_DIR="/opt/feather"
readonly SYSTEMD_DIR="/etc/systemd/system"
readonly NGINX_DIR="/etc/nginx"
readonly BACKUP_BUCKET="feather-backups"
readonly AWS_REGION="eu-central-1"
readonly LOCK_FILE="/run/lock/feather-deployment-backup.lock"
readonly FAILED_BACKUP_DIR="/var/backups/feather/failed"

umask 077

if [[ "$EUID" -ne 0 ]]; then
    echo "Run this script with sudo so it can read all deployed resources." >&2
    exit 1
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "A deployment backup is already running; refusing to start another."
    exit 1
fi

archive_paths=()
for component in backend web-app web-static; do
    if [[ ! -d "$INSTALL_DIR/$component" ]]; then
        echo "Missing deployed runtime directory: $INSTALL_DIR/$component" >&2
        exit 1
    fi
    archive_paths+=("opt/feather/$component")
done

if [[ -d "$INSTALL_DIR/swift-runtime" ]]; then
    archive_paths+=(opt/feather/swift-runtime)
fi

for executable_path in \
    backend/Server \
    backend/Migrator \
    backend/Worker \
    web-app/WebApp \
    web-static/WebStatic; do
    if [[ ! -x "$INSTALL_DIR/$executable_path" ]]; then
        echo "Missing deployed executable: $INSTALL_DIR/$executable_path" >&2
        exit 1
    fi
done

for unit in \
    feather-migrator.service \
    feather-server.service \
    feather-worker.service \
    feather-web-app.service \
    feather-web-static.service; do
    config_path="$SYSTEMD_DIR/$unit"
    if [[ ! -f "$config_path" ]]; then
        echo "Missing systemd unit: $config_path" >&2
        exit 1
    fi
    archive_paths+=("${config_path#/}")

    enabled_link="$SYSTEMD_DIR/multi-user.target.wants/$unit"
    if [[ -L "$enabled_link" ]]; then
        archive_paths+=("${enabled_link#/}")
    fi
done

nginx_main="$NGINX_DIR/nginx.conf"
nginx_site="$NGINX_DIR/sites-available/beta.feathercms.com.conf"
nginx_enabled_site="$NGINX_DIR/sites-enabled/beta.feathercms.com.conf"
for config_path in "$nginx_main" "$nginx_site"; do
    if [[ ! -f "$config_path" ]]; then
        echo "Missing Nginx configuration: $config_path" >&2
        exit 1
    fi
    archive_paths+=("${config_path#/}")
done
if [[ ! -L "$nginx_enabled_site" && ! -f "$nginx_enabled_site" ]]; then
    echo "Missing enabled Nginx site config: $nginx_enabled_site" >&2
    exit 1
fi
archive_paths+=("${nginx_enabled_site#/}")

backup_date="$(date -u +%Y/%m/%d)"
backup_timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_key="live/${backup_date}/deployment-${backup_timestamp}.tar.gz"
archive_file="$(mktemp /var/tmp/feather-deployment-backup.XXXXXX.tar.gz)"
preserve_archive=0
cleanup() {
    if (( preserve_archive )); then
        local retained_file
        retained_file="${FAILED_BACKUP_DIR}/deployment-$(date -u +%Y%m%dT%H%M%SZ)-$$.tar.gz"
        if install -d -o root -g root -m 0700 "$FAILED_BACKUP_DIR" \
            && mv "$archive_file" "$retained_file"; then
            chmod 0600 "$retained_file"
            printf 'S3 upload failed; retained the release archive at %s\n' \
                "$retained_file" >&2
        else
            printf 'S3 upload failed; release archive remains at %s\n' \
                "$archive_file" >&2
        fi
    else
        rm -f "$archive_file"
    fi
}
trap cleanup EXIT

tar -I 'gzip -1' -cf "$archive_file" -C / "${archive_paths[@]}"
if [[ ! -s "$archive_file" ]]; then
    echo "Release archive is empty; refusing to upload it." >&2
    exit 1
fi

tar -tzf "$archive_file" >/dev/null
if tar -tzf "$archive_file" | grep -Eq '(^|/)Feather\.env$'; then
    echo "Release archive unexpectedly contains feather.env; refusing to upload it." >&2
    exit 1
fi

if ! aws --region "$AWS_REGION" s3 cp \
    "$archive_file" "s3://${BACKUP_BUCKET}/${backup_key}" \
    --only-show-errors; then
    preserve_archive=1
    exit 1
fi

printf 'Uploaded deployment archive to s3://%s/%s (%s bytes)\n' \
    "$BACKUP_BUCKET" "$backup_key" "$(stat -c '%s' "$archive_file")"
