# Copy to /etc/nginx/sites-available/beta.feathercms.com.conf and enable it.
# Adjust the certificate paths to the paths used by acme.sh on the server.

upstream feather_web_app {
    server 127.0.0.1:3456;
}

upstream feather_static {
    server 127.0.0.1:4567;
}

server {
    listen 80;
    listen [::]:80;
    server_name beta.feathercms.com;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name beta.feathercms.com;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    ssl_certificate /etc/nginx/ssl/beta.feathercms.com/fullchain.cer;
    ssl_certificate_key /etc/nginx/ssl/beta.feathercms.com/private.key;

    client_max_body_size 1g;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # This stylesheet is generated by WebApp, not served from public files.
    location = /admin/style.css {
        proxy_pass http://feather_web_app;
    }

    location /admin/media/assets/ {
        proxy_pass http://feather_web_app;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Asset requests under /admin/ still reach WebStatic when they have a file
    # extension; admin pages without one reach WebApp below.
    location ~* \.(?:css|js|png|jpe?g|gif|svg|ico|webp|avif|mp4|webm|woff2?|ttf|otf)$ {
        proxy_pass http://feather_static;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    location / {
        proxy_pass http://feather_web_app;
    }
}
