{{& page.contents.html}}

<div id="news" class="wrapper">
    {{#empty(items)}}<p>Empty.</p>{{/empty(items)}}
    {{^empty(items)}}
    <div class="grid grid-321">
    {{#items}}
        {{> news/partials/item}}
    {{/items}}
    </div>
    {{/empty(items)}}
</div>

{{#pagination}}
<nav class="pagination" aria-label="News pages">
    {{#previousURL}}<a href="{{previousURL}}" rel="prev">Previous</a>{{/previousURL}}
    {{#pages}}
        {{#isCurrent}}<span aria-current="page">{{number}}</span>{{/isCurrent}}
        {{^isCurrent}}<a href="{{url}}">{{number}}</a>{{/isCurrent}}
    {{/pages}}
    {{#nextURL}}<a href="{{nextURL}}" rel="next">Next</a>{{/nextURL}}
</nav>
{{/pagination}}
