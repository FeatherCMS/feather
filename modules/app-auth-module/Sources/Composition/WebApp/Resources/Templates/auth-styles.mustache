<style>
    :root {
        color-scheme: light;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #1f2937;
        background: #f3f4f6;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; }
    .auth-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 32px 20px;
        background: #f3f4f6;
    }
    .auth-card {
        width: 100%;
        max-width: 440px;
        margin-top: 10vh;
        padding: 32px;
        border: 1px solid #d1d5db;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 12px 26px 2px #00000014;
    }
    .auth-header h1 { margin: 0 0 8px; font-size: 1.5rem; }
    .auth-header p { margin: 0; color: #4b5563; }
    .auth-form { display: flex; flex-direction: column; gap: 18px; margin-top: 24px; }
    .auth-form label { display: flex; flex-direction: column; gap: 8px; }
    .auth-form input:not([type="checkbox"]) {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #9ca3af;
        border-radius: 8px;
        font: inherit;
    }
    .auth-checkbox { flex-direction: row !important; align-items: center; }
    .auth-form button {
        width: 100%;
        padding: 12px 16px;
        border: 0;
        border-radius: 8px;
        color: #fff;
        background: #2563eb;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
    }
    .auth-message { margin: 18px 0 0; padding: 12px 14px; border-radius: 8px; }
    .auth-message--error, .auth-field-error { color: #991b1b; }
    .auth-message--error { background: #fef2f2; }
    .auth-message--success { color: #166534; background: #f0fdf4; }
    .auth-links { display: flex; flex-direction: column; gap: 10px; margin-top: 28px; }
    .auth-links a { color: #1d4ed8; }
</style>
